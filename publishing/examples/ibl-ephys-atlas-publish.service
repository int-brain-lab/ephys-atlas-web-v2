[Unit]
Description=IBL Ephys Atlas v2 publishing service
After=network.target

[Service]
User=ephys-publish
Group=ephys-publish
WorkingDirectory=/opt/ibl-ephys-atlas-web-v2
Environment=IBL_PUBLISH_STORAGE=/srv/ephys-publish/storage
Environment=IBL_PUBLISH_CREDENTIALS=/srv/ephys-publish/credentials.json
Environment="IBL_PUBLISH_VALIDATOR=/usr/local/bin/uv run --project /opt/ibl-ephys-atlas-web-v2/builder --locked --no-sync ephys-atlas-data validate {release_dir}"
Environment=IBL_PUBLISH_MAX_JSON_BYTES=33554432
Environment=IBL_PUBLISH_MAX_CHUNK_BYTES=16777216
ExecStart=/usr/local/bin/uv run --project /opt/ibl-ephys-atlas-web-v2/publishing --extra server --locked --no-sync gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8080 ibl_ephys_atlas_publish.wsgi:application
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/ephys-publish

[Install]
WantedBy=multi-user.target
