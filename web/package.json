{
  "name": "ibl-ephys-atlas-web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test test/unit/*.test.js",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
