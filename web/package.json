{
  "name": "ibl-ephys-atlas-web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:real": "VITE_DATASET_CATALOG_URL=/__real-data/catalog.json vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test test/unit/*.test.js",
    "test:rendering": "rm -rf .rendering-test-dist && tsc -p tsconfig.rendering-test.json && mkdir -p .rendering-test-dist/fixtures/rendering && cp ../fixtures/rendering/linked-slices.fixture.json .rendering-test-dist/fixtures/rendering/ && node --test .rendering-test-dist/tests/rendering/*.test.js",
    "test:browser": "playwright test",
    "test:real-release": "playwright test --config playwright.real-release.config.ts",
    "test:brainwide-map-release": "playwright test --config playwright.brainwide-map.config.ts",
    "test:cluster-release": "playwright test --config playwright.cluster-release.config.ts",
    "test:volume-candidate": "playwright test --config playwright.volume-candidate.config.ts",
    "benchmark:real-volume": "playwright test --config playwright.volume-benchmark.config.ts",
    "benchmark:anatomy": "playwright test --config playwright.anatomy-benchmark.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:rendering"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/three": "0.185.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.60",
    "meshoptimizer": "1.2.0",
    "three": "0.185.1"
  }
}
