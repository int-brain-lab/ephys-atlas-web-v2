{
  "name": "ibl-ephys-atlas-web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "VITE_DATASET_CATALOG_URL=/__real-data/catalog.json vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test test/unit/*.test.js",
    "test:rendering": "tsc -p tsconfig.rendering-test.json && mkdir -p .rendering-test-dist/fixtures/rendering && cp ../fixtures/rendering/linked-slices.fixture.json .rendering-test-dist/fixtures/rendering/ && node --test .rendering-test-dist/tests/rendering/*.test.js",
    "test:browser": "playwright test",
    "test:real-release": "playwright test --config playwright.real-release.config.ts",
    "benchmark:real-volume": "playwright test --config playwright.volume-benchmark.config.ts",
    "benchmark:anatomy": "playwright test --config playwright.anatomy-benchmark.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:rendering"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
