{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "src",
    "module": "ES2022",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/application/**/*.ts",
    "src/core/**/*.ts",
    "src/domain/**/*.ts",
    "src/url/**/*.ts",
    "src/data/contracts.ts",
    "src/data/schema-v1.ts",
    "src/data/validate.ts",
    "src/data/local-archive.ts",
    "src/data/validation/schema-v1.ts",
    "src/data/validation/volume-v1.ts",
    "src/data/regional-data.ts",
    "src/data/regional-loader.ts",
    "src/data/resource-reader.ts",
    "src/data/atlas-regions.ts",
    "src/data/region-hierarchy.ts",
    "src/data/repository.ts",
    "src/data/http-source.ts",
    "src/data/prefetch.ts",
    "src/data/cache.ts",
    "src/rendering/chunked-volume-source.ts",
    "src/rendering/display-slice-inventory.ts",
    "src/rendering/region-id.ts",
    "src/rendering/3d/**/*.ts",
    "src/ui/regional/model.ts",
    "src/ui/regional/histogram-curve.ts",
    "src/ui/regional/comparison-export.ts",
    "src/ui/color-range.ts",
    "src/ui/dataset-presentation.ts"
  ],
  "exclude": [
    "test/browser/**/*.ts",
    "playwright.config.ts"
  ]
}
