{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/catalog.schema.json",
  "title": "Public dataset catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "datasets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "title", "releases"],
        "properties": {
          "dataset_id": {"$ref": "common.schema.json#/$defs/datasetId"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "default_release": {"type": "string"},
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["release_id", "manifest"],
              "properties": {
                "release_id": {"type": "string", "minLength": 1},
                "manifest": {"$ref": "common.schema.json#/$defs/encodedResource"}
              }
            }
          }
        }
      }
    }
  }
}
