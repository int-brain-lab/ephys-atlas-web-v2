{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/artifact.schema.json",
  "title": "Downloadable artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "resource"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "role": {"enum": ["current-feature", "selected-data", "source-snapshot", "auxiliary", "whole-release"]},
    "resource": {"$ref": "common.schema.json#/$defs/encodedResource"},
    "description": {"type": "string"}
  }
}
