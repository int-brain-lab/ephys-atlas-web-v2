{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/regional.schema.json",
  "title": "Regional representation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "parcellations"],
  "properties": {
    "format": {"const": "ephys-atlas-regional-v1"},
    "parcellations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parcellation_id", "summary", "values", "statistics"],
        "properties": {
          "parcellation_id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "values": {"$ref": "common.schema.json#/$defs/binaryArray"},
          "statistics": {"$ref": "common.schema.json#/$defs/jsonResource"}
        }
      }
    }
  }
}
