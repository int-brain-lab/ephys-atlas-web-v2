{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/provenance.schema.json",
  "title": "Release provenance v1",
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "immutable", "created_at"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "immutable": {"const": true},
        "created_at": {"type": "string", "format": "date-time"},
        "paper_snapshot": {"type": "boolean"},
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"doi": {"type": "string"}, "label": {"type": "string"}}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "description"],
      "properties": {
        "role": {"enum": ["scientific-code", "canonical-data", "selection-freeze", "publication-input", "user-input", "atlas-geometry"]},
        "description": {"type": "string", "minLength": 1},
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "path": {"type": "string"},
        "release": {"type": "string"},
        "uri": {"type": "string"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "license": {"type": "string"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "builder", "recipe"],
  "properties": {
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "command": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operating_system", "machine", "python", "numpy"],
          "properties": {
            "operating_system": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1},
            "python": {"type": "string", "minLength": 1},
            "numpy": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
