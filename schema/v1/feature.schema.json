{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/feature.schema.json",
  "title": "Feature descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "label", "description", "unit", "value_semantics", "representations", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "unit": {"type": ["string", "null"]},
    "value_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "transform", "source_population", "missing_values"],
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "transform": {"type": "string", "minLength": 1},
        "source_population": {"type": "string", "minLength": 1},
        "missing_values": {"type": "string", "minLength": 1},
        "source_column": {"type": "string"},
        "qc_filter": {"type": "string"}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colormap": {"type": "string"},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "scale": {"enum": ["linear", "log"]}
      }
    },
    "representations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "regional": {"$ref": "regional.schema.json"},
        "volume": {"$ref": "volume.schema.json"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "artifact.schema.json"}}
  }
}
