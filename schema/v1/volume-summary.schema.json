{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/volume-summary.schema.json",
  "title": "Whole-feature volume summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "grid_id", "grid_shape", "total_voxel_count", "valid_voxel_count", "outside_voxel_count", "missing_voxel_count", "valid_statistics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "format": {"const": "ephys-atlas-volume-summary-v1"},
    "grid_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "grid_shape": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
    "total_voxel_count": {"type": "integer", "minimum": 1},
    "valid_voxel_count": {"type": "integer", "minimum": 0},
    "outside_voxel_count": {"type": "integer", "minimum": 0},
    "missing_voxel_count": {"type": "integer", "minimum": 0},
    "valid_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "mean", "std", "q05", "q25", "median", "q75", "q95"],
      "properties": {
        "min": {"type": ["number", "null"]},
        "max": {"type": ["number", "null"]},
        "mean": {"type": ["number", "null"]},
        "std": {"type": ["number", "null"]},
        "q05": {"type": ["number", "null"]},
        "q25": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]},
        "q75": {"type": ["number", "null"]},
        "q95": {"type": ["number", "null"]}
      }
    },
    "histogram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "counts", "bin_rule"],
      "properties": {
        "edges": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "bin_rule": {"const": "left-closed-right-open-last-closed"}
      }
    }
  }
}
