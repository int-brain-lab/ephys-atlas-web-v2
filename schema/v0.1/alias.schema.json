{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v0.1/alias.schema.json",
  "title": "Mutable release alias v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "alias", "release_id"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "alias": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "release_id": {"type": "string", "minLength": 1}
  }
}
